/**
 * WhatsApp Chat Analyzer - Frontend Styles
 * Authentic WhatsApp Design Theme
 */

/* ===== WhatsApp Color Palette ===== */
:root {
  /* WhatsApp Official Colors */
  --whatsapp-green: #25D366;
  --whatsapp-dark-green: #075E54;
  --whatsapp-teal: #128C7E;
  --whatsapp-light-green: #DCF8C6;
  --whatsapp-blue: #34B7F1;
  --whatsapp-gray: #ECE5DD;
  --whatsapp-dark-gray: #F0F2F5;
  --whatsapp-white: #FFFFFF;
  --whatsapp-border: #D1D7DB;
  --whatsapp-hover: #F5F6F6;
  --whatsapp-text: #303030;
  --whatsapp-text-light: #667781;
  --whatsapp-text-gray: #8696A0;
  
  /* Shadows */
  --shadow-sm: 0 1px 3px rgba(11, 20, 26, 0.08);
  --shadow: 0 2px 5px rgba(11, 20, 26, 0.13);
  --shadow-lg: 0 4px 15px rgba(11, 20, 26, 0.15);
}

/* ===== Reset & Base ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background: var(--whatsapp-dark-gray);
  color: var(--whatsapp-text);
  line-height: 1.6;
  position: relative;
}

/* WhatsApp-style subtle background */
body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(7, 94, 84, 0.02) 35px, rgba(7, 94, 84, 0.02) 70px),
    repeating-linear-gradient(-45deg, transparent, transparent 35px, rgba(37, 211, 102, 0.02) 35px, rgba(37, 211, 102, 0.02) 70px);
  pointer-events: none;
  z-index: -1;
}

/* ===== Header (WhatsApp Style) ===== */
.header {
  background: var(--whatsapp-dark-green);
  color: white;
  padding: 1.5rem 2rem;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  position: relative;
}

/* WhatsApp logo indicator */
.header::before {
  content: '';
  position: absolute;
  left: 2rem;
  width: 45px;
  height: 45px;
  background: var(--whatsapp-green);
  border-radius: 50%;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}

.header h1 {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: 0.3px;
}

.header-icon {
  font-size: 2rem;
  filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.2));
}

/* ===== Container ===== */
.container {
  max-width: 1100px;
  margin: 2rem auto;
  padding: 0 1rem;
}

/* ===== Section Cards (WhatsApp Style) ===== */
.section {
  background: var(--whatsapp-white);
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow);
  transition: box-shadow 0.2s ease;
  border: 1px solid var(--whatsapp-border);
  animation: fadeIn 0.3s ease-out;
}

.section:hover {
  box-shadow: var(--shadow-lg);
}

.section-title {
  font-size: 1.25rem;
  font-weight: 500;
  color: var(--whatsapp-dark-green);
  margin-bottom: 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--whatsapp-gray);
}

/* ===== Upload Area (WhatsApp Message Style) ===== */
.upload-area {
  border: 2px dashed var(--whatsapp-border);
  border-radius: 8px;
  padding: 2.5rem;
  text-align: center;
  transition: all 0.2s ease;
  cursor: pointer;
  background: var(--whatsapp-dark-gray);
}

.upload-area:hover {
  border-color: var(--whatsapp-green);
  background: rgba(37, 211, 102, 0.05);
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.upload-area.drag-over {
  border-color: var(--whatsapp-green);
  background: rgba(37, 211, 102, 0.1);
  border-style: solid;
}

.upload-icon {
  font-size: 3.5rem;
  color: var(--whatsapp-green);
  margin-bottom: 1rem;
  display: block;
}

.upload-text {
  font-size: 1.1rem;
  color: var(--whatsapp-text);
  font-weight: 500;
  margin-bottom: 0.5rem;
}

.upload-hint {
  font-size: 0.9rem;
  color: var(--whatsapp-text-light);
  margin-bottom: 1.5rem;
}

/* ===== Buttons (WhatsApp Green) ===== */
.btn {
  background: var(--whatsapp-green);
  color: white;
  border: none;
  padding: 0.75rem 1.75rem;
  font-size: 0.95rem;
  font-weight: 500;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-sm);
}

.btn:hover {
  background: #20BA5A;
  box-shadow: var(--shadow);
}

.btn:active {
  transform: scale(0.98);
}

.btn:disabled {
  background: var(--whatsapp-text-gray);
  cursor: not-allowed;
  opacity: 0.6;
}

input[type="file"] {
  display: none;
}

/* ===== Summary Cards (Message Bubble Style) ===== */
.summary-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.summary-card {
  background: var(--whatsapp-light-green);
  padding: 1.5rem;
  border-radius: 8px;
  text-align: center;
  transition: all 0.2s ease;
  border: 1px solid rgba(37, 211, 102, 0.2);
  box-shadow: var(--shadow-sm);
  animation: fadeIn 0.3s ease-out;
}

.summary-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.summary-card-label {
  font-size: 0.85rem;
  color: var(--whatsapp-text-light);
  margin-bottom: 0.5rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.summary-card-value {
  font-size: 2.25rem;
  font-weight: 600;
  color: var(--whatsapp-dark-green);
  line-height: 1.2;
}

/* ===== Chart Container ===== */
.chart-wrapper {
  margin-top: 1.5rem;
}

.chart-container {
  height: 380px;
  margin: 1.5rem 0;
  padding: 1.25rem;
  background: var(--whatsapp-dark-gray);
  border-radius: 8px;
  border: 1px solid var(--whatsapp-border);
}

.chart-description {
  margin-top: 1.25rem;
  padding: 1rem;
  background: var(--whatsapp-light-green);
  border-radius: 8px;
  border-left: 3px solid var(--whatsapp-green);
}

.chart-description p {
  margin: 0.5rem 0;
  color: var(--whatsapp-text);
  font-size: 0.9rem;
  line-height: 1.5;
}

/* ===== User List (Contact List Style) ===== */
.user-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 1rem;
}

.user-card {
  background: var(--whatsapp-white);
  padding: 1rem 1.25rem;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 1rem;
  transition: all 0.2s ease;
  border: 1px solid var(--whatsapp-border);
  cursor: pointer;
  animation: fadeIn 0.3s ease-out;
}

.user-card:hover {
  background: var(--whatsapp-hover);
}

/* User Avatar (WhatsApp Profile Picture) */
.user-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--whatsapp-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--whatsapp-dark-green);
  font-weight: 500;
  flex-shrink: 0;
  border: 2px solid var(--whatsapp-border);
}

.user-info {
  flex: 1;
}

.user-name {
  font-weight: 500;
  color: var(--whatsapp-text);
  font-size: 1rem;
  margin-bottom: 0.25rem;
}

.user-activity {
  font-size: 0.85rem;
  color: var(--whatsapp-text-light);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Badge (WhatsApp Notification Style) */
.badge {
  background: var(--whatsapp-green);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 500;
  min-width: 24px;
  text-align: center;
}

/* ===== Loading Spinner (WhatsApp Style) ===== */
.loading {
  text-align: center;
  padding: 2.5rem;
}

.spinner {
  display: inline-block;
  width: 50px;
  height: 50px;
  border: 4px solid var(--whatsapp-gray);
  border-top-color: var(--whatsapp-green);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 1rem;
  color: var(--whatsapp-text-light);
  font-size: 0.95rem;
  font-weight: 500;
}

/* ===== Error Messages ===== */
.error {
  background: #FFF4F4;
  border: 1px solid #FFCCCC;
  border-left: 3px solid #E74C3C;
  color: #C0392B;
  padding: 1rem 1.25rem;
  border-radius: 6px;
  margin: 1rem 0;
}

/* ===== Animations ===== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== Responsive Design ===== */
@media (max-width: 768px) {
  .header {
    padding: 1.25rem 1rem;
  }
  
  .header::before {
    left: 1rem;
    width: 40px;
    height: 40px;
  }
  
  .header h1 {
    font-size: 1.25rem;
  }
  
  .container {
    margin: 1rem auto;
    padding: 0 0.75rem;
  }
  
  .section {
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }
  
  .summary-cards {
    grid-template-columns: 1fr;
  }
  
  .upload-area {
    padding: 2rem 1rem;
  }
  
  .chart-container {
    height: 300px;
    padding: 1rem;
  }
}

@media (max-width: 480px) {
  .header h1 {
    font-size: 1.1rem;
  }
  
  .section-title {
    font-size: 1.1rem;
  }
  
  .summary-card-value {
    font-size: 1.75rem;
  }
  
  .user-avatar {
    width: 42px;
    height: 42px;
    font-size: 1.1rem;
  }
}

/* ===== Utility Classes ===== */
.text-center {
  text-align: center;
}

.mt-1 { margin-top: 0.5rem; }
.mt-2 { margin-top: 1rem; }
.mt-3 { margin-top: 1.5rem; }
.mb-1 { margin-bottom: 0.5rem; }
.mb-2 { margin-bottom: 1rem; }
.mb-3 { margin-bottom: 1.5rem; }

/* ===== Print Styles ===== */
@media print {
  body {
    background: white;
  }
  
  .header {
    background: var(--whatsapp-dark-green);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  
  .btn {
    display: none;
  }
  
  .section {
    break-inside: avoid;
    page-break-inside: avoid;
  }
}
