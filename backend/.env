PORT=5000
NODE_ENV=development

API_PREFIX=/api
CORS_ORIGIN=*

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.txt
UPLOAD_DIR=./uploads

DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

ENCRYPTION_KEY=whatsapp-chat-analyzer-secret-key-2026
HASH_SALT=chat-analyzer-salt
