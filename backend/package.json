{
  "name": "whatsapp-chat-analyzer-backend",
  "version": "2.0.0",
  "description": "Backend API for WhatsApp Chat Analyzer with TypeScript",
  "main": "src/app.ts",
  "scripts": {
    "start": "nodemon -r dotenv/config src/app.ts",
    "dev": "nodemon",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf build",
    "docker:build": "docker build -t whatsapp-analyzer-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env whatsapp-analyzer-backend",
    "docker:dev": "docker-compose up backend",
    "docker:prod": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend"
  },
  "keywords": [
    "whatsapp",
    "chat",
    "analyzer",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "joi": "^18.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
